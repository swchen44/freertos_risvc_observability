+
+/* Research-only: plugin async work runs outside cpu_exec with the BQL held. */
+void icount_set_virtual_clock(int64_t new_time)
+{
+    CPUState *cpu;
+    unsigned cpus = 0;
+    int64_t now;
+
+    CPU_FOREACH(cpu) {
+        cpus++;
+    }
+    if (icount_enabled() != ICOUNT_PRECISE || cpus != 1 ||
+        (current_cpu && current_cpu->running) || new_time < 0) {
+        error_report("experimental clock requires one stopped vCPU and fixed icount");
+        exit(1);
+    }
+    seqlock_write_lock(&timers_state.vm_clock_seqlock,
+                       &timers_state.vm_clock_lock);
+    now = icount_get_locked();
+    /* An already-passed absolute target is a no-op, never a clock reversal. */
+    if (new_time > now) {
+        qatomic_set_i64(&timers_state.qemu_icount_bias,
+                        timers_state.qemu_icount_bias + (new_time - now));
+    }
+    seqlock_write_unlock(&timers_state.vm_clock_seqlock,
+                         &timers_state.vm_clock_lock);
 }
 
